{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallos",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (dashboard: Workers & Pages > wallos > Logs) and readable stack traces.
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // The free https://wallos.<account>.workers.dev address. With a custom domain
  // below it can be switched off ("workers_dev": false).
  "workers_dev": true,
  // A custom domain on a zone in the same Cloudflare account (DNS and the
  // certificate are created on deploy). Then also set APP_URL below.
  // "routes": [{ "pattern": "wallos.example.com", "custom_domain": true }],

  // The web interface's stylesheets, scripts, fonts and images, copied from
  // the PHP repository by scripts/build-assets.ts. A matching file is served
  // directly; everything else reaches the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Create the database with `npx wrangler d1 create wallos` and paste the
  // returned database_id here before the first remote migration/deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wallos",
      "database_id": "77fe2741-2dfa-43b1-9a6a-db5371ed1c87",
      "migrations_dir": "migrations"
    }
  ],

  // Uploaded logos, icons and avatars. Create with: npx wrangler r2 bucket create wallos-files
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "wallos-files" }],

  // Optional: resize uploads with Cloudflare Images (needs Images enabled on
  // the account). Without it images are stored as uploaded.
  // "images": { "binding": "IMAGES" },

  // Optional: Cloudflare Workers AI as a provider for AI recommendations
  // (billed to the account; the paid plan includes a daily free allowance).
  // "ai": { "binding": "AI" },

  // Optional: an extra per-address limit on login attempts with Workers Rate
  // Limiting, on top of the D1 counters that are always on.
  // "ratelimits": [{ "name": "LOGIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],

  // One hourly trigger. Reminders go out at 09:00 (payments) and 08:00
  // (cancellations) in each user's own timezone; the daily jobs run at 01:00
  // (next payment dates; Mondays also the yearly cost snapshot) and 02:00
  // (exchange rates) UTC, and due AI recommendations a few per hour. See src/cron/.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "vars": {
    "SESSION_TTL_DAYS": "30",
    // Sender for all e-mail; the domain must be verified in Resend.
    // The API key is a secret: npx wrangler secret put RESEND_API_KEY
    "EMAIL_FROM": "Wallos <wallos@example.com>",
    // Base URL for links in e-mails when the admin has not set server_url.
    "APP_URL": ""
    // OIDC can be configured on the admin page, or pinned here with PHP Wallos'
    // variable names (the client secret as a secret: wrangler secret put OIDC_CLIENT_SECRET):
    // "OIDC_ENABLED": "true", "OIDC_PROVIDER_NAME": "Authentik", "OIDC_CLIENT_ID": "...",
    // "OIDC_ISSUER": "https://auth.example.com/application/o/wallos/",
    // "OIDC_REDIRECT_URL": "https://wallos.example.com/", "OIDC_DISABLE_PASSWORD_LOGIN": "false"
  }
}
